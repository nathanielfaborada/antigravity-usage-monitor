{
  "name": "agy-quota-monitor",
  "displayName": "Antigravity Usage Monitor",
  "description": "Monitors Antigravity token limits in status bar",
  "version": "0.0.1",
  "publisher": "nathaniel-faborada",
  "repository": {
    "type": "git",
    "url": "https://github.com/nathanielfaborada/antigravity-usage-monitor.git"
  },
  "engines": {
    "vscode": "^1.137.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
  "onStartupFinished"
    ],
  "main": "./extension.js",
  "contributes": {
    "commands": [
      {
        "command": "antigravity.refreshUsage",
        "title": "Antigravity: Refresh Usage"
      }
    ],
    "configuration": {
      "title": "Antigravity Usage Monitor",
      "properties": {
        "antigravity.cliPath": {
          "type": "string",
          "default": "agy",
          "description": "Executable name or absolute path to the agy CLI binary.",
          "scope": "resource"
        }
      }
    }
  },
  "scripts": {
    "lint": "eslint .",
    "pretest": "npm run lint",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/vscode": "^1.137.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "24.x",
    "eslint": "^10.5.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.0.0"
  },
  "overrides": {
    "diff": "^8.0.4",
    "serialize-javascript": "^7.0.6"
  }
}
